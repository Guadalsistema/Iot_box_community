#: code:addons/community_iot_box/models/iot_job.py:0
#. module: community_iot_box
msgid "A job in state '%s' must be assigned to an IoT Box."
msgstr "Un trabajo en estado '%s' debe estar asignado a una caja IoT."

#. module: community_iot_box
msgid "PDF documents can only be sent to a Standard Printer device."
msgstr "Los documentos PDF solo pueden enviarse a un dispositivo de impresora estándar."

#. module: community_iot_box
msgid "Document print jobs require a PDF attachment."
msgstr "Los trabajos de impresión de documentos requieren un adjunto PDF."

#. module: community_iot_box
msgid "Select an active Standard Printer with an IoT Box."
msgstr "Seleccione una impresora estándar activa con una caja IoT."

#. module: community_iot_box
msgid "The Standard Printer has no system printer name."
msgstr "La impresora estándar no tiene nombre de impresora del sistema."

#. module: community_iot_box
msgid "The generated document is not a valid PDF."
msgstr "El documento generado no es un PDF válido."

#. module: community_iot_box
msgid "The PDF exceeds the 25 MiB limit."
msgstr "El PDF supera el límite de 25 MiB."

#. module: community_iot_box
msgid "Copies must be between 1 and 10."
msgstr "Las copias deben estar entre 1 y 10."

#. module: community_iot_box
msgid "Select an active ticket or Standard Printer with an IoT Box."
msgstr "Seleccione un ticket activo o una impresora estándar con una caja IoT."

#. module: community_iot_box
msgid "Only failed PDF document jobs can be retried."
msgstr "Solo se pueden reintentar trabajos de documentos PDF fallidos."

#. module: community_iot_box
msgid "The PDF is no longer available; create a new print job."
msgstr "El PDF ya no está disponible; cree un nuevo trabajo de impresión."

#. module: community_iot_box
msgid "Only pending or failed PDF document jobs can be cancelled."
msgstr "Solo se pueden cancelar trabajos de documentos PDF pendientes o fallidos."

